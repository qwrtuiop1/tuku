# =============================================
# 腾讯云数据万象 CI 配置
# 文档: https://cloud.tencent.com/document/product/460/陆地
# =============================================
# 启用腾讯云 CI（true=启用，false=禁用）
CI_ENABLE=false

# 腾讯云区域（默认: ap-guangzhou）
CI_REGION=ap-guangzhou

# 腾讯云 SecretId（从腾讯云控制台获取）
CI_SECRET_ID=your_secret_id_here

# 腾讯云 SecretKey（从腾讯云控制台获取）
CI_SECRET_KEY=your_secret_key_here

# COS 存储桶名称（格式: bucketname-appid）
CI_BUCKET=your-bucket-name-1250000000

# COS 存储桶 AppId（通常为数字，与 bucket 名后的数字一致）
CI_APPID=1250000000

# 自定义 COS 域名（可选，不填则使用默认域名）
# CI_COS_HOST=cos.yourdomain.com

# 图片审核开关（true=启用，false=禁用）
CI_MODERATION_ENABLE=true

# 异步审核开关（true=先放行后回调，false=同步等待结果）
# 异步模式用户体验更好，同步模式更安全
CI_MODERATION_ASYNC=false

# 缩略图使用 CI 生成（true=使用CI，false=使用本地sharp）
CI_THUMBNAIL_ENABLE=true

# CI 截图样式（CI 图片处理参数）
CI_THUMBNAIL_STYLE=imageMogr2/thumbnail/300x300/gravity/center/interlace/1/quality/80

# OCR 文字识别开关（true=启用，false=禁用）
CI_OCR_ENABLE=true

# =============================================
# COS 前端直传配置（STS 临时密钥）
# =============================================
# STS 临时密钥有效期（秒），默认 2 小时
COS_STS_DURATION=7200

# 可选：CAM 角色 ARN（使用角色授权时填写）
# 格式: qcs::cam::uin/{account}:roleName/{roleName}
# COS_ROLE_ARN=
# 角色会话名称
# COS_ROLE_SESSION_NAME=cos-sts-session