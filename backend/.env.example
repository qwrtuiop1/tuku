# ============================================
# 图库系统 - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# 重要：.env 文件不要提交到代码仓库！
# ============================================

# --- 数据库配置（必填）---
DB_HOST=localhost
DB_USER=tuku
DB_PASSWORD=your_secure_password_here
DB_NAME=tuku

# --- JWT 密钥（必填，使用随机字符串，建议 32+ 字符）---
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# --- 管理员账户（必填，密码建议 12+ 位）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@tuku.com

# --- 服务端口（可选，默认 3000）---
PORT=3000

# --- 上传路径（可选）---
UPLOAD_PATH=/www/wwwroot/tuku/backend/storage

# --- 腾讯云 COS 配置（可选，用于前端直传）---
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=tuku-1234567890
COS_REGION=ap-guangzhou

# --- QQ 登录（可选）---
QQ_APP_ID=your_qq_app_id
QQ_APP_KEY=your_qq_app_key
QQ_REDIRECT_URI=http://localhost:3000/api/auth/qq/callback

# --- EPass 登录（可选）---
EPASS_CLIENT_ID=your_epass_client_id
EPASS_CLIENT_SECRET=your_epass_client_secret
EPASS_REDIRECT_URI=http://localhost:3000/api/auth/epass/callback

# --- 极验验证码（可选）---
GEETEST_CAPTCHA_ID=your_geetest_id
GEETEST_CAPTCHA_KEY=your_geetest_key

# --- 节点环境 ---
NODE_ENV=development